# Copy to `.env.local` (any mode) or `.env.<mode>` and adjust. Without any of these the app
# targets the local stack (`scripts/local-er.sh`). Production builds (`vite build`) require
# VITE_BASE_RPC, VITE_ER_RPC, VITE_PROGRAM_ID, VITE_ER_VALIDATOR and VITE_VRF_QUEUE.
# Ready-made devnet config: `.env.devnet` (`pnpm -C app dev --mode devnet`).

# Base layer (HTTP; the websocket defaults to ws(s)://, RPC port + 1).
VITE_BASE_RPC=https://api.devnet.solana.com
# VITE_BASE_WS=wss://api.devnet.solana.com

# MagicBlock ephemeral rollup: the DEFAULT region (players pick Europe / US / Asia in the top
# bar when the base RPC is devnet). The validator identity MUST match the endpoint (it is
# pinned in `delegate_player`). Devnet (getIdentity / devnet-router getRoutes, 2026-10-10):
#   https://devnet-eu.magicblock.app  MEUGGrYPxKk17hCr7wpT6s8dtNokZj5U2L57vjYMS8e
#   https://devnet-us.magicblock.app  MUS3hc9TCw4cGC12vHNoYcCGzJG1txjgQLZWVoeNHNd
#   https://devnet-as.magicblock.app  MAS1Dt9qreoRMQ14YQuhg8UTZMMzDdKhmkZMECCzk57
# (devnet-tee is a private ER that needs auth tokens: not supported.)
VITE_ER_RPC=https://devnet-eu.magicblock.app
# VITE_ER_WS=wss://devnet-eu.magicblock.app
VITE_ER_VALIDATOR=MEUGGrYPxKk17hCr7wpT6s8dtNokZj5U2L57vjYMS8e

# Optional: your own region list instead of the built-in devnet table (JSON; `ws` optional).
# With it a production build does not need VITE_ER_RPC / VITE_ER_VALIDATOR (default = first).
# VITE_ER_REGIONS=[{"id":"eu","label":"Europe","rpc":"https://devnet-eu.magicblock.app","validator":"MEUGGrYPxKk17hCr7wpT6s8dtNokZj5U2L57vjYMS8e"}]

# The deployed magicraft program (devnet).
VITE_PROGRAM_ID=4y2JKsSfShA6tL5K9Vk3NZPPev1bq29AqqNK9iYF9euz
# VRF oracle queue for request_seed: DEFAULT_EPHEMERAL_QUEUE (devnet/mainnet ERs). Must match
# the queue the program was built with (`pnpm build:release` checks it).
VITE_VRF_QUEUE=5hBR571xnXppuCPveTrctfTU7tJLSN94nq7kv7FRK5Tc

# Optional: Wallet Standard chain id (default derived from VITE_BASE_RPC: solana:devnet).
# VITE_WALLET_CHAIN=solana:devnet
# Optional: offer the in-browser burner wallet on a non-local, non-mainnet RPC (it is always
# offered against a local RPC and never on mainnet). Devnet has no faucet for it here.
# VITE_BURNER=1
